# Supabase project connection (safe to expose in the browser — anon/public key only).
# Never put a service_role key or DB password in this app.
# IMPORTANT: use the exact same project URL/anon key as the manor-cares-users app —
# both apps share one Supabase project/database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
